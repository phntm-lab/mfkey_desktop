{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MFKey Desktop",
  "version": "0.1.0",
  "identifier": "com.phntmlab.mfkey_desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MFKey Desktop",
        "width": 1100,
        "height": 700,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "rpm", "app", "dmg"],
    "category": "Utility",
    "shortDescription": "Recover MIFARE Classic keys from Flipper Zero logs.",
    "longDescription": "MFKey Desktop recovers MIFARE Classic (Crypto-1) keys from Flipper Zero nonce logs. It supports offline log files and a live Auto mode that communicates with a Flipper Zero over USB or BLE.",
    "publisher": "PhantomLab",
    "copyright": "Copyright © 2026 Lemn4t. Licensed under GPL-3.0-only.",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libudev1",
          "libdbus-1-3",
          "bluez"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "systemd-libs",
          "dbus-libs",
          "bluez"
        ]
      }
    }
  }
}
